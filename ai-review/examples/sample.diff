@@ -1,14 +1,40 @@
 const sgMail = require('@sendgrid/mail');
 const settings = require('../config/settings');
+const db = require('../db');

 sgMail.setApiKey(settings.sendgrid.apiKey);

-async function sendWelcomeEmail(user) {
-  await sgMail.send({ to: user.email, from: 'noreply@example.com', subject: 'Welcome!', text: 'Thanks for signing up.' });
+async function sendWelcomeEmail(user) {
+  sgMail.send({ to: user.email, from: 'noreply@example.com', subject: 'Welcome!', text: 'Thanks for signing up.' });
 }

-async function sendPasswordResetEmail(user, token) {
-  await sgMail.send({ to: user.email, from: 'noreply@example.com', subject: 'Reset password', text: `Token: ${token}` });
+async function sendPasswordResetEmail(user, token) {
+  sgMail.send({ to: user.email, from: 'noreply@example.com', subject: 'Reset your password', text: `Your reset token: ${token}` });
 }

+async function sendBulkNotifications(userIds, message) {
+  const users = await db.query('SELECT email FROM users WHERE id IN (?)', [userIds]);
+  for (const user of users) {
+    sgMail.send({
+      to: user.email,
+      from: 'noreply@example.com',
+      subject: 'Notification',
+      text: message,
+    });
+  }
+}
+
+async function getUserNotificationPreferences(userId) {
+  const prefs = await db.query('SELECT * FROM notification_prefs WHERE user_id = ?', [userId]);
+  return prefs[0];
+}
+
+async function updateNotificationPreferences(userId, prefs) {
+  const existing = await getUserNotificationPreferences(userId);
+  if (existing) {
+    await db.query('UPDATE notification_prefs SET email_enabled = ?, sms_enabled = ? WHERE user_id = ?',
+      [prefs.emailEnabled, prefs.smsEnabled, userId]);
+  } else {
+    await db.query('INSERT INTO notification_prefs (user_id, email_enabled, sms_enabled) VALUES (?, ?, ?)',
+      [userId, prefs.emailEnabled, prefs.smsEnabled]);
+  }
+}
+
+const unusedHelper = (arr) => arr.filter(x => x !== null);
+
 module.exports = { sendWelcomeEmail, sendPasswordResetEmail, sendBulkNotifications, updateNotificationPreferences };
