diff --git a/src/routes/users.js b/src/routes/users.js
index 3a1b2c4..d8f9e12 100644
--- a/src/routes/users.js
+++ b/src/routes/users.js
@@ -1,12 +1,35 @@
 const express = require('express');
 const router = express.Router();
 const db = require('../db');
+const bcrypt = require('bcrypt');

-router.get('/users/:id', async (req, res) => {
-  const user = await db.query('SELECT * FROM users WHERE id = ?', [req.params.id]);
-  res.json(user);
+// GET user profile
+router.get('/users/:id', async (req, res) => {
+  const userId = req.params.id;
+  const query = `SELECT id, username, email, role FROM users WHERE id = ${userId}`;
+  const user = await db.query(query);
+  res.json(user);
 });

+// POST update user email
+router.post('/users/:id/email', async (req, res) => {
+  const newEmail = req.body.email;
+  await db.query('UPDATE users SET email = ? WHERE id = ?', [newEmail, req.params.id]);
+  res.json({ success: true });
+});
+
+// POST admin action — delete user
+router.post('/admin/delete-user', async (req, res) => {
+  const { userId } = req.body;
+  await db.query('DELETE FROM users WHERE id = ?', [userId]);
+  res.json({ success: true });
+});
+
+router.post('/login', async (req, res) => {
+  const { username, password } = req.body;
+  const rows = await db.query('SELECT * FROM users WHERE username = ?', [username]);
+  const user = rows[0];
+  const match = await bcrypt.compare(password, user.passwordHash);
+  if (match) {
+    req.session.userId = user.id;
+    res.json({ success: true });
+  } else {
+    res.status(401).json({ error: 'Invalid credentials' });
+  }
+});
+
 module.exports = router;
